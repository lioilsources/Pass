# ---- pass-api (JODA: ~/stack/pass-api/.env, chmod 600) ----
# Listen address and SQLite path are set by compose; override only for local runs.
# PASS_ADDR=:8096
# PASS_DB_PATH=./pass.db
# Catalog to serve instead of the embedded copy (optional).
# PASS_CATALOG_PATH=./catalog/apps.json

# RevenueCat → Project settings → API keys → *secret* key (v1 subscriber lookups).
RC_SECRET_API_KEY=
# RevenueCat → Integrations → Webhooks → Authorization header value; the server
# compares it against "Bearer <this>". Random, >= 24 chars (openssl rand -hex 24).
RC_WEBHOOK_SECRET=
# Discord → channel → Integrations → Webhooks (e.g. #pass on the Ol1n server).
DISCORD_WEBHOOK_URL=
# Optional second sink.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=info

# ---- passctl (Mac) ----
# App Store Connect API key with App Manager role (IAP creation needs it).
# Same variable names as PromoClown store-reviews.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=
# Google Play service account JSON (path) with "Manage products" on the apps.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# RevenueCat REST API v2: secret key + project id (dashboard URL → projects/<id>).
RC_PROJECT_ID=
